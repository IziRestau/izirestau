{
  "name": "iziresto",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @iziresto/database prisma generate",
    "db:migrate": "pnpm --filter @iziresto/database prisma migrate dev",
    "db:push": "pnpm --filter @iziresto/database prisma db push",
    "db:studio": "pnpm --filter @iziresto/database prisma studio",
    "db:seed": "pnpm --filter @iziresto/database prisma db seed"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
