// ============================================
// SUPPORT TICKETS
// ============================================

model SupportTicket {
  id                String    @id @default(cuid())
  
  ticketNumber      String    @unique
  
  // Type de ticket (qui contacte qui)
  ticketType        TicketType
  
  // Createur du ticket
  createdById       String
  createdBy         User      @relation("TicketCreator", fields: [createdById], references: [id])
  
  // Organisation reseller (pour tickets Reseller -> Platform OU Restaurant -> Reseller)
  resellerOrgId     String?
  resellerOrg       ResellerOrganization? @relation(fields: [resellerOrgId], references: [id], onDelete: Cascade)
  
  // Restaurant (pour tickets Restaurant -> Reseller)
  restaurantId      String?
  restaurant        Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  subject           String
  category          TicketCategory
  priority          TicketPriority @default(MEDIUM)
  status            TicketStatus   @default(OPEN)
  
  // Assignation (admin IziResto ou membre reseller)
  assignedToId      String?
  assignedTo        User?     @relation("TicketAssignee", fields: [assignedToId], references: [id])
  
  messages          SupportMessage[]
  
  lastMessageAt     DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([resellerOrgId])
  @@index([restaurantId])
  @@index([createdById])
  @@index([status])
  @@index([ticketNumber])
  @@index([ticketType])
}

model SupportMessage {
  id              String    @id @default(cuid())
  
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  senderId        String
  sender          User      @relation(fields: [senderId], references: [id])
  
  content         String    @db.Text
  attachments     String[]  @default([])
  
  isInternal      Boolean   @default(false)
  isFromAdmin     Boolean   @default(false)
  
  readAt          DateTime?
  
  createdAt       DateTime  @default(now())
  
  @@index([ticketId])
  @@index([senderId])
}

enum TicketType {
  RESELLER_TO_PLATFORM    // Reseller contacte IziResto
  RESTAURANT_TO_RESELLER  // Restaurant contacte son Reseller
}

enum TicketCategory {
  BILLING
  TECHNICAL
  FEATURE_REQUEST
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_REPLY
  RESOLVED
  CLOSED
}

