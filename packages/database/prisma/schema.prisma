// ============================================
// EMAIL CAMPAIGNS & TEMPLATES (Restaurant)
// ============================================

model EmailCampaign {
  id              String    @id @default(cuid())
  
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name            String
  subject         String
  content         String    @db.Text
  
  type            EmailCampaignType @default(PROMOTIONAL)
  status          EmailCampaignStatus @default(DRAFT)
  
  // Ciblage (legacy - pour rétrocompatibilité)
  targetAll       Boolean   @default(true)
  targetSegment   String?   // 'loyal', 'inactive', 'new', 'birthday'
  targetMinPoints Int?
  targetMaxPoints Int?
  
  // Ciblage flexible (nouveau)
  targetingRules  Json?     // Structure flexible de ciblage multi-critères
  
  // Statistiques
  recipientCount  Int       @default(0)
  sentCount       Int       @default(0)
  openCount       Int       @default(0)
  clickCount      Int       @default(0)
  
  scheduledAt     DateTime?
  sentAt          DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  recipients      EmailCampaignRecipient[]
  
  @@index([restaurantId])
  @@index([status])
}

enum EmailCampaignType {
  PROMOTIONAL
  NEWSLETTER
  ANNOUNCEMENT
  LOYALTY
  BIRTHDAY
  REACTIVATION
}

enum EmailCampaignStatus {
  DRAFT
  PENDING
  SENDING
  SENT
  CANCELLED
}

model EmailCampaignRecipient {
  id              String    @id @default(cuid())
  
  campaignId      String
  campaign        EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  customerId      String
  customer        RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  email           String
  status          EmailRecipientStatus @default(PENDING)
  
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  unsubscribedAt  DateTime?
  
  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@index([customerId])
}

enum EmailRecipientStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
}

model RestaurantEmailTemplate {
  id              String    @id @default(cuid())
  
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  type            RestaurantEmailType
  subject         String
  content         String    @db.Text
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([restaurantId, type])
  @@index([restaurantId])
}

enum RestaurantEmailType {
  ORDER_CONFIRMATION
  ORDER_READY
  ORDER_DELIVERED
  LOYALTY_POINTS_EARNED
  LOYALTY_POINTS_REDEEMED
  WELCOME
  BIRTHDAY
  RECEIPT
}

// ============================================
// CUSTOMER TAG RULES (Attribution automatique)
// ============================================

model CustomerTagRule {
  id              String    @id @default(cuid())
  
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name            String    // "Client VIP", "Amateur de Pizza"
  tag             String    // Tag à attribuer
  description     String?
  
  isActive        Boolean   @default(true)
  
  // Conditions (structure JSON flexible)
  // { "operator": "AND"|"OR", "conditions": [...] }
  conditions      Json
  
  // Déclencheur
  triggerOnOrder  Boolean   @default(true)  // Évaluer après chaque commande
  
  // Stats
  customersMatched Int      @default(0)
  lastEvaluatedAt DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([restaurantId])
  @@index([isActive])
}
