// ============================================
// RECEIPTS & INVOICES (Facturation Restaurant)
// ============================================

model ReceiptTemplate {
  id              String    @id @default(cuid())
  
  // Null = template système, sinon = template custom du restaurant
  restaurantId    String?
  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  type            ReceiptType
  
  // Templates Liquid
  htmlTemplate    String    @db.Text
  thermalTemplate String?   @db.Text
  cssStyles       String?   @db.Text
  
  // Métadonnées
  previewImage    String?
  isSystem        Boolean   @default(false)
  isDefault       Boolean   @default(false)
  
  receipts        Receipt[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([restaurantId])
  @@index([type])
  @@index([isSystem])
}

model Receipt {
  id              String    @id @default(cuid())
  
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id])
  
  templateId      String
  template        ReceiptTemplate @relation(fields: [templateId], references: [id])
  
  // Numérotation fiscale séquentielle
  receiptNumber   String
  fiscalYear      Int
  sequenceNumber  Int
  
  type            ReceiptType
  
  // Snapshot immuable des données au moment de l'émission
  restaurantInfo  Json
  customerInfo    Json?
  items           Json
  totals          Json
  
  // Conformité NF525
  signature       String?
  previousHash    String?
  
  // PDF
  pdfUrl          String?
  pdfGeneratedAt  DateTime?
  
  // Email
  emailSentAt     DateTime?
  emailSentTo     String?
  
  // Impression
  printedAt       DateTime?
  printedBy       String?
  
  // Annulation
  isVoided        Boolean   @default(false)
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  
  createdAt       DateTime  @default(now())
  
  @@unique([restaurantId, fiscalYear, sequenceNumber])
  @@index([restaurantId])
  @@index([orderId])
  @@index([receiptNumber])
  @@index([createdAt])
}

model ReceiptSettings {
  id                      String    @id @default(cuid())
  
  restaurantId            String    @unique
  restaurant              Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  // Templates sélectionnés par type
  ticketTemplateId        String?
  invoiceSimpleTemplateId String?
  invoiceFullTemplateId   String?
  
  // Personnalisation
  logo                    String?
  thankYouMessage         String?   @default("Merci de votre visite !")
  footerText              String?
  
  // QR Code
  showQrCode              Boolean   @default(true)
  qrCodeType              String    @default("receipt")
  qrCodeCustomUrl         String?
  
  // Automatisation
  autoPrintOnOrder        Boolean   @default(false)
  autoEmailOnOrder        Boolean   @default(false)
  defaultReceiptType      ReceiptType @default(TICKET)
  
  // Numérotation
  receiptPrefix           String    @default("TK")
  nextSequenceNumber      Int       @default(1)
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

enum ReceiptType {
  TICKET
  INVOICE_SIMPLE
  INVOICE_FULL
}

