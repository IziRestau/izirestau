# Database
DATABASE_URL="postgresql://user:password@localhost:5432/iziresto?schema=public"

# Redis (Railway provides REDIS_URL automatically when the Redis plugin is attached)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Stripe (not used yet)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Paytech (Africa)
PAYTECH_API_KEY=""
PAYTECH_SECRET_KEY=""

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@izirestau.online"

# Mapbox
MAPBOX_ACCESS_TOKEN=""

# Vercel API (used by API to add reseller custom domains)
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# App URLs / CORS
FRONTEND_URL="https://app.izirestau.online"
API_URL="https://api.izirestau.online"

# Multiple comma-separated origins (admin., app., apex, www, custom domains, Vercel previews)
CORS_ORIGINS="https://izirestau.online,https://www.izirestau.online,https://app.izirestau.online,https://admin.izirestau.online"
# Optional regex patterns (e.g. *.izirestau.online and Vercel previews)
CORS_ORIGIN_PATTERNS="^https://[a-z0-9-]+\\.izirestau\\.online$,^https://[a-z0-9-]+-[a-z0-9-]+\\.vercel\\.app$"

# Cron secret (external trigger)
CRON_SECRET="change-me-in-production"

# Puppeteer (set automatically in Docker; override here for local dev if Chrome is in a non-standard path)
# CHROME_PATH=""

# Node
NODE_ENV="development"

# ---- Frontend (apps/web) - prefix NEXT_PUBLIC_ to expose to the browser ----

NEXT_PUBLIC_API_URL="https://api.izirestau.online/api"
NEXT_PUBLIC_ROOT_DOMAIN="izirestau.online"
NEXT_PUBLIC_CDN_HOST="cdn.izirestau.online"
